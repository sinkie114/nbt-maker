{
  "schemaVersion": 1,
  "id": "nbt-maker",
  "version": "${version}",
  "name": "NBT Maker",
  "description": "物品堆数据调试器：本地编辑、多人只读、组件树与 SNBT。",
  "authors": [
    "sinkie114"
  ],
  "license": "CC0-1.0",
  "icon": "assets/nbt-maker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.sinkie114.client.NbtMakerClient"
    ],
    "modmenu": [
      "com.sinkie114.client.compat.NbtMakerModMenu"
    ]
  },
  "mixins": [
    {
      "config": "nbt-maker.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}